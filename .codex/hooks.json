{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/block_dangerous_bash.py\"",
            "statusMessage": "위험 명령어 검사"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" || exit 0; if [ ! -f package.json ]; then exit 0; fi; npm run lint 2>&1 && npm run build 2>&1 && npm run test 2>&1",
            "statusMessage": "lint · build · test"
          }
        ]
      }
    ]
  }
}
