# FinSight 환경변수. 실제 값은 .env.local 에 넣는다 (.gitignore 에 있음).
# Vercel 에도 같은 목록을 Production·Preview 양쪽에 설정해야 한다.

# --- 사이트 -------------------------------------------------------------
# 배포된 앱의 공개 base URL. OG 이미지의 절대 URL 기준점(src/app/layout.tsx
# metadataBase)으로 쓴다. 비우면 Next 가 VERCEL_URL 로 추론한다.
NEXT_PUBLIC_APP_URL=

# --- Supabase -----------------------------------------------------------
# 프로젝트 API 설정의 Project URL. 브라우저·서버·미들웨어 클라이언트 전부.
NEXT_PUBLIC_SUPABASE_URL=

# 브라우저에 노출해도 되는 anon key. RLS 가 걸린 사용자 데이터 조회용.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service role key. RLS 를 우회하므로 서버 전용이다 — src/app/api/ 라우트와
# src/inngest/ 워커에서만 쓴다. 클라이언트 번들에 절대 넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# 로컬 Supabase 에서 Google 로그인을 켤 때만 필요하다(supabase/config.toml 의
# [auth.external.google] 가 이 두 값을 읽는다). 원격 프로젝트는 대시보드에서
# 설정하므로 배포에는 쓰이지 않는다. Google Cloud 콘솔의 OAuth 클라이언트 값.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- OpenAI -------------------------------------------------------------
# 가맹점 분류·컬럼 매핑·신호 서술 호출. src/services/openai.ts 에서만 읽는다.
OPENAI_API_KEY=

# --- Inngest ------------------------------------------------------------
# 업로드 파이프라인 이벤트 발행 키. inngest SDK 가 직접 읽는다.
INNGEST_EVENT_KEY=

# /api/inngest 로 들어오는 요청의 서명 검증 키. 없으면 외부에서 워커를
# 호출할 수 있다. inngest/next 의 serve() 가 직접 읽는다.
INNGEST_SIGNING_KEY=

# --- Polar (결제, Merchant of Record) ------------------------------------
# 서버에서 체크아웃·고객 포털 세션을 만들 때 쓰는 액세스 토큰.
POLAR_ACCESS_TOKEN=

# sandbox(테스트 모드) 또는 production.
POLAR_SERVER=sandbox

# /api/webhooks/polar 의 서명 검증 시크릿. Polar 대시보드에서 웹훅을 등록할 때
# 발급된다. 검증이 없으면 결제 없이 구독이 켜진다.
POLAR_WEBHOOK_SECRET=

# 월 4,900원 요금제의 Polar product ID.
POLAR_PRODUCT_ID_MONTHLY=

# 연 49,000원 요금제의 Polar product ID.
POLAR_PRODUCT_ID_YEARLY=
