# App base URL for local development or the deployed Vercel app.
NEXT_PUBLIC_APP_URL=

# Supabase project URL from the project API settings.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase browser-safe anon key from the project API settings.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key for server-only route handlers and workers.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase private Storage bucket name for raw transaction CSV uploads.
SUPABASE_STORAGE_BUCKET=

# OpenAI API key for server-side model calls.
OPENAI_API_KEY=

# Inngest event key for sending background job events.
INNGEST_EVENT_KEY=

# Inngest signing key for verifying /api/inngest requests.
INNGEST_SIGNING_KEY=

# Polar access token for server-side checkout and portal calls.
POLAR_ACCESS_TOKEN=

# Polar webhook secret for verifying incoming billing events.
POLAR_WEBHOOK_SECRET=

# Polar product ID for the FinSight paid plan.
POLAR_PRODUCT_ID=
